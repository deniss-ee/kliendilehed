# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kliendilehed
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/kliendilehed

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# MinIO Local Object Store
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET_NAME=product-images

# Scraper Concurrency & Rate Limiting
SCRAPER_DEFAULT_DELAY_SECONDS=1.0
SCRAPER_CONCURRENCY_LIMIT=5
SCRAPER_REQUEST_TIMEOUT=30
